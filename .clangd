---
CompileFlags:
  Add: [ -std=c++26, -x, c++ ]
  Remove: [ -freflection ]
  CompilationDatabase: ./build/vcpkg-multi-config/
Diagnostics:
  MissingIncludes: None
  UnusedIncludes: Strict
Completion:
  HeaderInsertion: Never
InlayHints:
  Enabled: true
  DeducedTypes: true
  TypeNameLimit: 24
---
If:
  PathMatch: .*\.(cl|h|c)$
CompileFlags:
  Add: [ -x, c ]
  Remove: [ -std=c++26 ]
---
If:
  PathMatch: pch/pch\.hpp
Diagnostics:
  UnusedIncludes: None
...
