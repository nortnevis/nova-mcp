CompileFlags:
  CompilationDatabase: build/vcpkg-multi-config/
  Add:
    - -std=c++26
    - -freflection-latest
    - -nostdinc++
    - -isystem
    - tools/lib/libcxx/include
Diagnostics:
  UnusedIncludes: Strict
Completion:
  HeaderInsertion: Never
InlayHints:
  Enabled: true
  DeducedTypes: true
  TypeNameLimit: 24
---
If:
  PathMatch: pch/pch\.hpp
Diagnostics:
  UnusedIncludes: None
